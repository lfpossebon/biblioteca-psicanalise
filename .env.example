# Copie para .env e ajuste. Nunca commite o .env.

# Banco (padrão: psi/psi/psilib). O Postgres só aplica estes valores ao criar o volume pgdata.
# POSTGRES_USER=psi
# POSTGRES_PASSWORD=troque-esta-senha
# POSTGRES_DB=psilib

# Pasta do acervo local no host (padrão: a pasta acima deste projeto)
# CORPUS_DIR_HOST=/Users/voce/Desktop/Antigos/PSICANALISE

# Embeddings: local (BAAI/bge-m3, sem custo, ~2 GB) ou voyage (API paga, mais rápido)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
# Revisão fixa do modelo (reprodutibilidade). Ao trocar EMBEDDING_MODEL, ajuste ou deixe vazio (= main).
# EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DIM=1024
EMBEDDING_BATCH=16
# VOYAGE_API_KEY=

# Coleta web
HTTP_DELAY_SECONDS=2
# OPENALEX_MAILTO=seu-email@exemplo.com   # entra no "polite pool" do OpenAlex
